  equipo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>equipo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo"><B>id_equipo</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo">codigo</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT">NVARCHAR(80)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_disciplina">id_disciplina</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ciudad">ciudad</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fundacion">fecha_fundacion</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD></TD></TR></TABLE>>];
  entrenador_equipo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>entrenador_equipo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_asignacion"><B>id_asignacion</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_entrenador">id_entrenador</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo">id_equipo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol">rol</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio">fecha_inicio</TD><TD ALIGN="LEFT">DATE</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin">fecha_fin</TD><TD ALIGN="LEFT">DATE NULL</TD><TD></TD></TR></TABLE>>];
  integrante_equipo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>integrante_equipo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_integrante"><B>id_integrante</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_deportista">id_deportista</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo">id_equipo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="funcion">funcion</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_camiseta">numero_camiseta</TD><TD ALIGN="LEFT">TINYINT NULL</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio">fecha_inicio</TD><TD ALIGN="LEFT">DATE</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin">fecha_fin</TD><TD ALIGN="LEFT">DATE NULL</TD><TD></TD></TR></TABLE>>];
  escenario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>escenario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_escenario"><B>id_escenario</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo">codigo</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT">NVARCHAR(80)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo">tipo</TD><TD ALIGN="LEFT">VARCHAR(12)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ciudad">ciudad</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion">direccion</TD><TD ALIGN="LEFT">NVARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="capacidad">capacidad</TD><TD ALIGN="LEFT">INT</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(15)</TD><TD></TD></TR></TABLE>>];
  torneo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>torneo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_torneo"><B>id_torneo</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo">codigo</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT">NVARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="id_disciplina">id_disciplina</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio">fecha_inicio</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin">fecha_fin</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(12)</TD><TD></TD></TR></TABLE>>];
  inscripcion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>inscripcion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_inscripcion"><B>id_inscripcion</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_torneo">id_torneo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo">id_equipo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inscripcion">fecha_inscripcion</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD></TD></TR></TABLE>>];
  encuentro [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>encuentro</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_encuentro"><B>id_encuentro</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_torneo">id_torneo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_escenario">id_escenario</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_local">id_equipo_local</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_visitante">id_equipo_visitante</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora">fecha_hora</TD><TD ALIGN="LEFT">DATETIME2(0)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="jornada">jornada</TD><TD ALIGN="LEFT">SMALLINT</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(12)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="puntaje_local">puntaje_local</TD><TD ALIGN="LEFT">SMALLINT NULL</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="puntaje_visitante">puntaje_visitante</TD><TD ALIGN="LEFT">SMALLINT NULL</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="resultado_definitivo">resultado_definitivo</TD><TD ALIGN="LEFT">BIT</TD><TD></TD></TR></TABLE>>];
