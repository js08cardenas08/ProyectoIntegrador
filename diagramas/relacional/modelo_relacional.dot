// Modelo relacional - Caso 5: Gestión deportiva (generado desde el catálogo de SQL Server)
digraph relacional {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.6, fontname="Helvetica", labelloc=t, fontsize=20, pad=0.3,
         label=<<B>Caso 5 — Gestión deportiva: modelo relacional (SQL Server)</B><BR/><FONT POINT-SIZE="11">PK = clave primaria · FK = clave foránea · UQ = único · UQc = parte de un UNIQUE compuesto · línea: padre (1, barra) → hija (N, pata de gallo)</FONT>>];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#4A5568", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2];
  disciplina [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>disciplina</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_disciplina"><B>id_disciplina</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo">codigo</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deporte">deporte</TD><TD ALIGN="LEFT">NVARCHAR(40)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modalidad">modalidad</TD><TD ALIGN="LEFT">NVARCHAR(40)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rama">rama</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria">categoria</TD><TD ALIGN="LEFT">VARCHAR(12)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_participacion">tipo_participacion</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD></TD></TR></TABLE>>];
  persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>persona</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_persona"><B>id_persona</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_documento">tipo_documento</TD><TD ALIGN="LEFT">VARCHAR(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_documento">numero_documento</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres">nombres</TD><TD ALIGN="LEFT">NVARCHAR(60)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="apellidos">apellidos</TD><TD ALIGN="LEFT">NVARCHAR(60)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_nacimiento">fecha_nacimiento</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="sexo">sexo</TD><TD ALIGN="LEFT">CHAR(1)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="correo">correo</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono">telefono</TD><TD ALIGN="LEFT">VARCHAR(15) NULL</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro">fecha_registro</TD><TD ALIGN="LEFT">DATETIME2(0)</TD><TD></TD></TR></TABLE>>];
  deportista [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F0FFF4"><TR><TD COLSPAN="3" BGCOLOR="#22543D"><FONT COLOR="white"><B>deportista</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_deportista"><B>id_deportista</B></TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_persona">id_persona</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_disciplina">id_disciplina</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#9B2C2C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT">VARCHAR(12)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_ingreso">fecha_ingreso</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
